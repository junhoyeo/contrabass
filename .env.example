# Linear or GitHub project URL the orchestrator polls
CONTRABASS_PROJECT_URL=https://linear.app/your-org/project/your-project-id

# Linear assignee UUID (Linear settings → API → my user)
LINEAR_ASSIGNEE_ID=00000000-0000-0000-0000-000000000000

# Default model in `provider/name` form
CONTRABASS_MODEL=openai/gpt-5.5

# API key for the opencode provider (workflow.ohmyopencode.md)
OPENCODE_PROVIDER_API_KEY=sk-your-api-key-here

# GitHub tracker (when tracker.type=github — workflow.github.md, workflow.ohmyopencode.md)
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo
GITHUB_ASSIGNEE=your-github-username
# GITHUB_TOKEN must be a PAT with issues:read+write scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
